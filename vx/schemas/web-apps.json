{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vezham.com/schemas/web-apps.json",
  "title": "Vx web app deployment registry",
  "description": "Shared build defaults and category groups for Firebase/Nx web deployments. App IDs must be globally unique across groups. Store secret names, never secret values.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "integer",
      "const": 2,
      "description": "Registry format version."
    },
    "defaults": {
      "description": "Complete build profiles inherited by every app.",
      "type": "object",
      "properties": {
        "environments": {
          "type": "object",
          "properties": {
            "tva": {
              "$ref": "#/definitions/completeProfile"
            },
            "dev": {
              "$ref": "#/definitions/completeProfile"
            },
            "qa": {
              "$ref": "#/definitions/completeProfile"
            },
            "preview": {
              "$ref": "#/definitions/completeProfile"
            },
            "production": {
              "$ref": "#/definitions/completeProfile"
            }
          },
          "required": ["tva", "dev", "qa", "preview", "production"],
          "additionalProperties": false
        },
        "values": {
          "$ref": "#/definitions/buildValues"
        },
        "secret_values": {
          "$ref": "#/definitions/secretValues"
        }
      },
      "required": ["environments"],
      "additionalProperties": false
    },
    "apps": {
      "$ref": "#/definitions/appGroup",
      "description": "apps web applications."
    },
    "apps-cdns": {
      "$ref": "#/definitions/appGroup",
      "description": "cdns web applications."
    },
    "apps-internals": {
      "$ref": "#/definitions/appGroup",
      "description": "internals web applications."
    },
    "apps-platforms": {
      "$ref": "#/definitions/appGroup",
      "description": "platforms web applications."
    },
    "apps-pods": {
      "$ref": "#/definitions/appGroup",
      "description": "pods web applications."
    },
    "apps-suites": {
      "$ref": "#/definitions/appGroup",
      "description": "suites web applications."
    },
    "apps-widgets": {
      "$ref": "#/definitions/appGroup",
      "description": "widgets web applications."
    }
  },
  "required": ["schema", "defaults"],
  "additionalProperties": false,
  "definitions": {
    "profile": {
      "description": "Build settings. App overrides may specify only the fields they change.",
      "type": "object",
      "properties": {
        "build_environment": {
          "type": "string",
          "enum": ["dev", "qa", "preview", "production"],
          "description": "Destination-specific .env profile used during the build; TVA uses dev by default."
        },
        "release_channel": {
          "type": "string",
          "enum": ["canary", "beta", "stable"],
          "description": "Release channel used during the build."
        },
        "debug": {
          "type": "boolean",
          "description": "Whether the build enables debug mode."
        },
        "values": {
          "$ref": "#/definitions/buildValues"
        },
        "secret_values": {
          "$ref": "#/definitions/secretValues"
        }
      },
      "additionalProperties": false
    },
    "completeProfile": {
      "allOf": [
        {
          "$ref": "#/definitions/profile"
        },
        {
          "type": "object",
          "required": ["build_environment", "release_channel", "debug"]
        }
      ]
    },
    "credentialSecret": {
      "type": "string",
      "pattern": "^[A-Z_][A-Z0-9_]*$",
      "description": "Name of a GitHub Actions secret containing the Firebase service account credentials. Do not put the credential value here."
    },
    "app": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+$",
          "description": "Source repository in owner/repository form."
        },
        "path": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+(?:/[a-zA-Z0-9_.-]+)*$",
          "not": {
            "pattern": "(^|/)\\.{1,2}(/|$)"
          },
          "description": "App directory relative to the source repository root. Absolute paths and . or .. path segments are not allowed."
        },
        "credential_secrets": {
          "type": "object",
          "properties": {
            "tva": {
              "$ref": "#/definitions/credentialSecret"
            },
            "dev": {
              "$ref": "#/definitions/credentialSecret"
            },
            "qa": {
              "$ref": "#/definitions/credentialSecret"
            },
            "preview": {
              "$ref": "#/definitions/credentialSecret"
            },
            "production": {
              "$ref": "#/definitions/credentialSecret"
            }
          },
          "required": ["tva", "dev", "qa", "preview"],
          "additionalProperties": false
        },
        "environments": {
          "description": "Optional per-environment overrides merged with shared defaults, field by field.",
          "type": "object",
          "properties": {
            "tva": {
              "$ref": "#/definitions/profile"
            },
            "dev": {
              "$ref": "#/definitions/profile"
            },
            "qa": {
              "$ref": "#/definitions/profile"
            },
            "preview": {
              "$ref": "#/definitions/profile"
            },
            "production": {
              "$ref": "#/definitions/profile"
            }
          },
          "additionalProperties": false
        },
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Set false to exclude this app from manual and scheduled deployments."
        },
        "promotion_path": {
          "$ref": "#/definitions/promotionPath"
        },
        "values": {
          "$ref": "#/definitions/buildValues"
        },
        "secret_values": {
          "$ref": "#/definitions/secretValues"
        },
        "production_targets": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^[a-z0-9][a-z0-9-]*$": {
              "$ref": "#/definitions/productionTarget"
            }
          },
          "additionalProperties": false,
          "description": "Optional app-specific Production destinations. Each has its own credentials and overrides. Omit for a single Production deployment."
        }
      },
      "required": ["repository", "path", "credential_secrets"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "not": {
              "required": ["production_targets"]
            }
          },
          "then": {
            "properties": {
              "credential_secrets": {
                "required": ["production"]
              }
            }
          }
        }
      ]
    },
    "appGroup": {
      "type": "object",
      "description": "App entries keyed by globally unique lowercase IDs. Category is derived from the top-level group name.",
      "patternProperties": {
        "^[a-z0-9][a-z0-9-]*$": {
          "$ref": "#/definitions/app"
        }
      },
      "additionalProperties": false
    },
    "promotionPath": {
      "type": "array",
      "description": "Allowed promotion stages for this app, independent of category. Start with tva, end with production, preserve standard order and omit stages to skip them.",
      "items": {
        "type": "string",
        "enum": ["tva", "dev", "qa", "preview", "production"]
      },
      "minItems": 2,
      "maxItems": 5,
      "uniqueItems": true,
      "enum": [
        ["tva", "production"],
        ["tva", "dev", "production"],
        ["tva", "qa", "production"],
        ["tva", "dev", "qa", "production"],
        ["tva", "preview", "production"],
        ["tva", "dev", "preview", "production"],
        ["tva", "qa", "preview", "production"],
        ["tva", "dev", "qa", "preview", "production"]
      ],
      "default": ["tva", "dev", "qa", "preview", "production"]
    },
    "buildValues": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z_][A-Z0-9_]*$",
        "not": {
          "enum": [
            "V_APP_NAME",
            "V_APP_ENV",
            "V_RELEASE_CHANNEL",
            "V_IS_DEBUG",
            "V_PRODUCTION_TARGET"
          ]
        }
      },
      "additionalProperties": {
        "type": ["string", "number", "boolean"]
      },
      "description": "Public build variables. Do not store secret values here."
    },
    "secretValues": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z_][A-Z0-9_]*$",
        "not": {
          "enum": [
            "V_APP_NAME",
            "V_APP_ENV",
            "V_RELEASE_CHANNEL",
            "V_IS_DEBUG",
            "V_PRODUCTION_TARGET"
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/definitions/credentialSecret"
      },
      "description": "Build variable names mapped to GitHub Actions secret names."
    },
    "productionTarget": {
      "description": "Build settings. App overrides may specify only the fields they change.",
      "type": "object",
      "properties": {
        "build_environment": {
          "type": "string",
          "enum": ["dev", "qa", "preview", "production"],
          "description": "Destination-specific .env profile used during the build; TVA uses dev by default."
        },
        "release_channel": {
          "type": "string",
          "enum": ["canary", "beta", "stable"],
          "description": "Release channel used during the build."
        },
        "debug": {
          "type": "boolean",
          "description": "Whether the build enables debug mode."
        },
        "values": {
          "$ref": "#/definitions/buildValues"
        },
        "secret_values": {
          "$ref": "#/definitions/secretValues"
        },
        "credential_secret": {
          "$ref": "#/definitions/credentialSecret"
        }
      },
      "additionalProperties": false,
      "required": ["credential_secret"]
    }
  },
  "minProperties": 3
}
